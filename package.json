{
  "name": "asistente-convocatorias",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"next dev -p 3100\" \"tsx watch worker.ts\"",
    "dev:web": "next dev -p 3100",
    "dev:worker": "tsx watch worker.ts",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "playwright": "^1.49.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "unpdf": "^0.12.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
